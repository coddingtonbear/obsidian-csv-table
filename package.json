{
  "name": "obsidian-csv-table",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Render CSV data as a table within your notes.",
  "engines": {
    "node": ">=22"
  },
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck && tsc -noEmit -skipLibCheck -p tsconfig.test.json",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "Adam Coddington <me@adamcoddington.net>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "jsdom": "^27.4.0",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "filtrex": "^3.1.0"
  }
}
